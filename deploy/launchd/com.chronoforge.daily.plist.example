<?xml version="1.0" encoding="UTF-8"?>
<!--
  每日数据批次（北京时间 15:40 = 07:40 UTC）。
  这是样例：不会自动安装。使用前把 __PROJECT_DIR__ 替换为仓库绝对路径，
  然后 `cp` 到 ~/Library/LaunchAgents/ 并 `launchctl load`。
  注意 launchd 的 StartCalendarInterval 用本机时区，本样例按 Asia/Shanghai 写。
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.chronoforge.daily</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-lc</string>
    <string>__PROJECT_DIR__/scripts/hourly_update.sh daily</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__PROJECT_DIR__</string>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>15</integer>
    <key>Minute</key><integer>40</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>__PROJECT_DIR__/var/log/launchd_daily.out.log</string>
  <key>StandardErrorPath</key>
  <string>__PROJECT_DIR__/var/log/launchd_daily.err.log</string>
  <key>RunAtLoad</key>
  <false/>
</dict>
</plist>
