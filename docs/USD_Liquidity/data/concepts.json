[
  {"id":"CONCEPT_FOMC","name_cn":"联邦公开市场委员会（FOMC）","name_en":"Federal Open Market Committee","definition":"美联储的货币政策决策机构，每年约八次议息会议，依据经济数据投票决定联邦基金利率目标区间。","category":"机构与制度","source_document_ids":["DOC_FED"],"source_pages":[1],"verification_status":"author_claimed","notes":"原文称『每次会议12位美联储理事投票』；实际投票成员为7位理事+纽约联储主席+4位轮换地区联储主席，见 OPEN_QUESTION_FED_001。"},
  {"id":"CONCEPT_FFR_TARGET","name_cn":"联邦基金利率目标区间","name_en":"Federal Funds Rate Target Range","definition":"FOMC 设定的政策利率目标区间，通过 IORB 与 ON RRP 利率等工具框住市场利率。","category":"利率","source_document_ids":["DOC_FED"],"source_pages":[1,2,4],"verification_status":"author_claimed","notes":""},
  {"id":"CONCEPT_IORB","name_cn":"准备金利息（IORB）","name_en":"Interest on Reserve Balances","definition":"银行存放在美联储的准备金所获利率，『无风险收益地板』，是利率走廊的事实天花板。","category":"利率","source_document_ids":["DOC_FED"],"source_pages":[2,3,4,5],"verification_status":"author_claimed","notes":""},
  {"id":"CONCEPT_EFFR","name_cn":"联邦基金有效利率（EFFR）","name_en":"Effective Federal Funds Rate","definition":"银行间无担保隔夜拆借交易的成交量加权利率，由市场形成，是政策利率目标的锚。","category":"利率","source_document_ids":["DOC_FED","DOC_TGA"],"source_pages":[2,3,4,5,10],"verification_status":"author_claimed","notes":"FRED 代码 EFFR（DOC_TGA p8）。"},
  {"id":"CONCEPT_ONRRP","name_cn":"隔夜逆回购协议（ON RRP）","name_en":"Overnight Reverse Repurchase Agreement Facility","definition":"非银行机构（货币基金、GSE 等）把钱隔夜借给美联储的工具及利率，构成市场利率下限；余额是货币市场资金池的『蓄水池』。","category":"利率与工具","source_document_ids":["DOC_FED","DOC_TGA","DOC_LIQ"],"source_pages":[2,8],"verification_status":"author_claimed","notes":"FRED：RRPONTSYD 仅指国内 ON RRP，不含外国官方及国际账户（DOC_TGA p8）。"},
  {"id":"CONCEPT_SOFR","name_cn":"有担保隔夜融资利率（SOFR）","name_en":"Secured Overnight Financing Rate","definition":"以国债为抵押的回购市场隔夜利率，有抵押的短端市场基准；对回购市场流动性紧张极为敏感。","category":"利率","source_document_ids":["DOC_FED","DOC_TGA"],"source_pages":[2,5,6,10],"verification_status":"author_claimed","notes":"FRED 代码 SOFR（DOC_TGA p8）。"},
  {"id":"CONCEPT_SRF","name_cn":"常备回购便利（SRF）","name_en":"Standing Repo Facility","definition":"银行/一级交易商以国债、机构债、MBS 为抵押向美联储隔夜融资的常备工具，利率具惩罚性，定位为『最后缓冲垫』。","category":"工具","source_document_ids":["DOC_FED"],"source_pages":[2,7,8,9,10],"verification_status":"author_claimed","notes":"接受三类抵押品；使用量>3B 视为压力显性化（作者阈值）。"},
  {"id":"CONCEPT_TBILL","name_cn":"国库券（T-Bills）","name_en":"Treasury Bills","definition":"期限≤1年的零息贴现国债，折价发行、到期面值兑付，流动性最强的政府证券。","category":"国债","source_document_ids":["DOC_TSY","DOC_FED"],"source_pages":[1],"verification_status":"author_claimed","notes":"FRED：DTB4WK、DTB3/TB3MS、DTB6、DTB1YR。"},
  {"id":"CONCEPT_TNOTE","name_cn":"国库票据（T-Notes）","name_en":"Treasury Notes","definition":"1–10 年期固定票息国债，半年付息、到期还本，收益率曲线中段的核心。","category":"国债","source_document_ids":["DOC_TSY"],"source_pages":[1,2],"verification_status":"author_claimed","notes":"FRED：DGS2/3/5/7/10。"},
  {"id":"CONCEPT_TBOND","name_cn":"国库长期债券（T-Bonds）","name_en":"Treasury Bonds","definition":"10 年以上（一般 20/30 年）附息国债，对利率最敏感，长期资金成本与定价基准。","category":"国债","source_document_ids":["DOC_TSY"],"source_pages":[3],"verification_status":"author_claimed","notes":"FRED：DGS20、DGS30。"},
  {"id":"CONCEPT_TIPS","name_cn":"通胀保护证券（TIPS）","name_en":"Treasury Inflation-Protected Securities","definition":"本金随 CPI 调整、利息按调整后本金半年支付的国债，提供实际收益率；与名义国债收益率之差构成平衡通胀率。","category":"国债","source_document_ids":["DOC_TSY"],"source_pages":[3,4],"verification_status":"author_claimed","notes":"FRED：DFII5/10/30。"},
  {"id":"CONCEPT_FRN","name_cn":"浮动利率国债（FRNs）","name_en":"Floating Rate Notes","definition":"2 年期、票息每周按 13 周 T-Bill（DTB3）加固定利差重置的国债，2014 年首次发行。","category":"国债（特殊）","source_document_ids":["DOC_TSY"],"source_pages":[4],"verification_status":"author_claimed","notes":"FRED 无直接收益率序列。"},
  {"id":"CONCEPT_SLGS","name_cn":"州与地方政府系列国债（SLGS）","name_en":"State and Local Government Series","definition":"面向地方政府发行、不在公开市场交易的特种国债。","category":"国债（特殊）","source_document_ids":["DOC_TSY"],"source_pages":[4,5],"verification_status":"author_claimed","notes":""},
  {"id":"CONCEPT_CMB","name_cn":"现金管理券（CMBs）","name_en":"Cash Management Bills","definition":"几天至数月期的贴现短期国债，为应对财政收支时差不定期发行，收益率略高于常规 T-Bills。","category":"国债（特殊）","source_document_ids":["DOC_TSY","DOC_TGA"],"source_pages":[4,5],"verification_status":"author_claimed","notes":"发行数据见 TreasuryDirect。"},
  {"id":"CONCEPT_SAVINGS_BOND","name_cn":"储蓄债券（EE/I 系列）","name_en":"Savings Bonds","definition":"面向个人投资者的不可转让国债，EE 系列固定利率、I 系列与 CPI 挂钩，最长 30 年。","category":"国债（特殊）","source_document_ids":["DOC_TSY"],"source_pages":[5],"verification_status":"author_claimed","notes":""},
  {"id":"CONCEPT_STRIPS","name_cn":"剥离国债（STRIPS）","name_en":"Separate Trading of Registered Interest and Principal of Securities","definition":"将附息国债的本金与利息剥离、单独作为零息债券交易的机制，机构用于久期匹配。","category":"国债（特殊）","source_document_ids":["DOC_TSY"],"source_pages":[4,5],"verification_status":"author_claimed","notes":"FRED 零息曲线：GS1ZC/GS5ZC/GS10ZC/GS30ZC。"},
  {"id":"CONCEPT_BANK_RESERVES","name_cn":"银行准备金","name_en":"Reserve Balances","definition":"存款类金融机构存放在美联储的余额，用于银行间结算与流动性需求；是美元流动性框架的核心变量。","category":"美联储负债","source_document_ids":["DOC_TGA","DOC_LIQ","DOC_FED"],"source_pages":[1,11],"verification_status":"accounting_identity","notes":"FRED：WRESBAL。原文强调准备金≠整个金融市场流动性。"},
  {"id":"CONCEPT_TGA","name_cn":"财政部一般账户（TGA）","name_en":"Treasury General Account","definition":"财政部在美联储持有的现金账户；发债收款使其上升（抽水）、财政支出使其下降（放水）。","category":"美联储负债","source_document_ids":["DOC_TGA","DOC_LIQ"],"source_pages":[1,2,3],"verification_status":"accounting_identity","notes":"FRED：WTREGEN；DTS 的 Operating Cash Balance 为日频跟踪依据。"},
  {"id":"CONCEPT_TGA_TARGET","name_cn":"财政部现金余额目标","name_en":"Treasury Cash Balance Target","definition":"财政部在季度再融资公告中给出的季末（或特定日期）现金余额目标，是约束而非每日预测值。","category":"财政","source_document_ids":["DOC_TGA"],"source_pages":[3,12],"verification_status":"author_claimed","notes":"须区分季度末目标/某日目标/实际余额/市场推算余额（DOC_TGA p3）。"},
  {"id":"CONCEPT_FED_BALANCE_SHEET","name_cn":"美联储资产负债表","name_en":"Federal Reserve Balance Sheet","definition":"美联储资产（国债、MBS 等）与负债（准备金、TGA、ON RRP、流通现金等）的总账；其结构变化决定准备金水平。","category":"会计框架","source_document_ids":["DOC_TGA","DOC_LIQ"],"source_pages":[1,9],"verification_status":"accounting_identity","notes":"FRED：WALCL（总资产）、TREAST（国债持仓）、WSHOSHO（机构债+MBS）。"},
  {"id":"CONCEPT_CURRENCY","name_cn":"流通中现金","name_en":"Currency in Circulation","definition":"美联储负债端的社会公众持有现金项目，季节性波动，影响准备金水平。","category":"美联储负债","source_document_ids":["DOC_TGA","DOC_LIQ"],"source_pages":[9],"verification_status":"author_claimed","notes":"FRED：CURRCIR。"},
  {"id":"CONCEPT_QT","name_cn":"量化紧缩（QT）","name_en":"Quantitative Tightening","definition":"美联储持有证券到期不再全额再投资、资产负债表收缩的过程，是准备金的重要来源变量。","category":"政策","source_document_ids":["DOC_TGA"],"source_pages":[4,12,14],"verification_status":"author_claimed","notes":""},
  {"id":"CONCEPT_QE_RMP","name_cn":"扩表（原文称 RMP 买短债）","name_en":"Balance Sheet Expansion / RMP","definition":"原文指美联储买入短期国债的扩表操作（RMP 为原文用词，具体所指见待核查项）；扩表使准备金回升。","category":"政策","source_document_ids":["DOC_LIQ"],"source_pages":[1],"verification_status":"source_claimed","notes":"OPEN_QUESTION_LIQ_002：RMP 全称未在原文中定义。"},
  {"id":"CONCEPT_AMPLE_RESERVES","name_cn":"充足准备金框架","name_en":"Ample Reserves Framework","definition":"美联储维持充足而非最小准备金水平的操作框架；准备金需求、货币市场利率与供给的关系决定下降是否造成实质压力。","category":"制度机制","source_document_ids":["DOC_TGA"],"source_pages":[4],"verification_status":"author_claimed","notes":"原文引用克利夫兰联储研究。"},
  {"id":"CONCEPT_H41","name_cn":"H.4.1 报告","name_en":"H.4.1 Release","definition":"美联储每周发布的资产负债表报告，同时公布周三余额与周内日均值；是核对准备金/TGA/ON RRP 的官方依据。","category":"数据源","source_document_ids":["DOC_TGA","DOC_LIQ"],"source_pages":[8,10,14,15],"verification_status":"author_claimed","notes":"每周四发布（DOC_TGA p15）。"},
  {"id":"CONCEPT_DTS","name_cn":"每日财政报表（DTS）","name_en":"Daily Treasury Statement","definition":"财政部每日发布的现金流与债务操作报表，含 Operating Cash Balance、存提款、公共债务交易、税收与退税；次一工作日下午发布。","category":"数据源","source_document_ids":["DOC_TGA"],"source_pages":[7],"verification_status":"author_claimed","notes":""},
  {"id":"CONCEPT_MTS","name_cn":"月度财政报表（MTS）","name_en":"Monthly Treasury Statement","definition":"财政部月度收入、支出与赤字报表，用于建立财政收支基线模型。","category":"数据源","source_document_ids":["DOC_TGA"],"source_pages":[8],"verification_status":"author_claimed","notes":""},
  {"id":"CONCEPT_QRA","name_cn":"季度再融资声明（QRA）","name_en":"Quarterly Refunding Statement","definition":"财政部季度发布的融资计划：各品种发行安排、净融资预测、季末现金余额估计与现金管理计划。","category":"数据源","source_document_ids":["DOC_TGA"],"source_pages":[5,7,12],"verification_status":"author_claimed","notes":""},
  {"id":"CONCEPT_TREASURY_AUCTION","name_cn":"国债拍卖与结算","name_en":"Treasury Auction & Settlement","definition":"国债发行经公告、拍卖、结算三阶段；对流动性的实际冲击发生在结算日现金流，而非公告日或拍卖日。","category":"财政机制","source_document_ids":["DOC_TGA"],"source_pages":[7,11],"verification_status":"author_claimed","notes":""},
  {"id":"CONCEPT_SOMA","name_cn":"系统公开市场账户（SOMA）","name_en":"System Open Market Account","definition":"美联储持有的证券组合；国债拍卖中 SOMA 展期部分不构成对私人部门的净融资。","category":"美联储资产","source_document_ids":["DOC_TGA"],"source_pages":[11],"verification_status":"author_claimed","notes":""},
  {"id":"CONCEPT_NET_BORROWING","name_cn":"私人部门净市场融资","name_en":"Privately-held Net Marketable Borrowing","definition":"扣除到期偿还与 SOMA 展期后，向私人部门净发行的国债金额；与毛发行额是不同概念。","category":"财政指标","source_document_ids":["DOC_TGA"],"source_pages":[11],"verification_status":"author_claimed","notes":""},
  {"id":"CONCEPT_REPO","name_cn":"回购市场（Repo）","name_en":"Repurchase Agreement Market","definition":"以证券（主要为国债）为抵押的隔夜融资市场；SOFR 即其加权利率，抵押品可得性与需求决定利率波动。","category":"货币市场","source_document_ids":["DOC_FED","DOC_TGA"],"source_pages":[5,6,7,9],"verification_status":"author_claimed","notes":""},
  {"id":"CONCEPT_MBS","name_cn":"抵押贷款支持证券（MBS）","name_en":"Mortgage-Backed Securities","definition":"按揭贷款打包证券；agency MBS 由 GSE 担保，含预付款/凸性风险，估值依赖模型。","category":"证券","source_document_ids":["DOC_FED"],"source_pages":[7,8,9],"verification_status":"author_claimed","notes":""},
  {"id":"CONCEPT_AGENCY_DEBT","name_cn":"联邦机构债","name_en":"Federal Agency Securities","definition":"GSE（Fannie/Freddie）及联邦住房贷款银行等发行的债券，信用风险极低，SRF 备选抵押品。","category":"证券","source_document_ids":["DOC_FED"],"source_pages":[7,8],"verification_status":"author_claimed","notes":""},
  {"id":"CONCEPT_GSE","name_cn":"政府支持企业（GSE）","name_en":"Government-Sponsored Enterprises","definition":"房利美、房地美等；不能获得 IORB，在联邦基金市场作为贷方压低 EFFR。","category":"机构","source_document_ids":["DOC_FED"],"source_pages":[2,3],"verification_status":"author_claimed","notes":""},
  {"id":"CONCEPT_FHLB","name_cn":"联邦住房贷款银行（FHLB）","name_en":"Federal Home Loan Bank","definition":"政府支持机构，联邦基金市场的重要贷方，出借闲置资金，其大额低价出借拉低 EFFR 均值。","category":"机构","source_document_ids":["DOC_FED"],"source_pages":[3],"verification_status":"author_claimed","notes":""},
  {"id":"CONCEPT_DISCOUNT_WINDOW","name_cn":"贴现窗口","name_en":"Discount Window","definition":"银行以抵押品向美联储借款的工具，利率具惩罚性，用于头寸管理失当或危机时的后备融资。","category":"工具","source_document_ids":["DOC_FED"],"source_pages":[2],"verification_status":"author_claimed","notes":""},
  {"id":"CONCEPT_SPECIALNESS","name_cn":"特定券稀缺性（Specialness）","name_en":"Repo Specialness","definition":"某些券种（特定到期日/券龄）在回购市场被特别抢手、借入成本上升的现象。","category":"货币市场","source_document_ids":["DOC_FED"],"source_pages":[7,8,9],"verification_status":"author_claimed","notes":""},
  {"id":"CONCEPT_HAIRCUT","name_cn":"抵押折价（Haircut）","name_en":"Haircut","definition":"回购/SRF 中对抵押品估值的折扣，覆盖价格波动、流动性与预付款风险；国债最低、MBS 最高。","category":"风险管理","source_document_ids":["DOC_FED"],"source_pages":[7,8],"verification_status":"author_claimed","notes":""},
  {"id":"CONCEPT_GOVERNMENT_SHUTDOWN","name_cn":"联邦政府停摆","name_en":"Government Shutdown","definition":"参众两院未通过预算导致非必要联邦机构停止运作；暂停经济数据发布、财政拨款与资金池调节，扰动国债供给节奏与回购市场。","category":"事件类型","source_document_ids":["DOC_FED","DOC_LIQ"],"source_pages":[6],"verification_status":"author_claimed","notes":""},
  {"id":"CONCEPT_DXY","name_cn":"美元指数（DXY）","name_en":"US Dollar Index","definition":"美元对一篮子主要货币的汇率指数；原文定位为全球流动性与避险货币需求的温度计（『钱往哪跑』）。","category":"市场指标","source_document_ids":["DOC_DXY"],"source_pages":[1],"verification_status":"author_claimed","notes":"原始 PDF 未给出 FRED 代码；补充参考 DTWEXBGS（广义美元，见 variables.json 标注）。"},
  {"id":"CONCEPT_UST","name_cn":"美债收益率（UST）","name_en":"US Treasury Yields","definition":"各期限国债收益率；原文定位为增长预期+通胀+货币政策的合成读数。使用时须拆分实际利率/通胀预期/期限溢价。","category":"市场指标","source_document_ids":["DOC_DXY","DOC_TSY"],"source_pages":[1],"verification_status":"author_claimed","notes":""},
  {"id":"CONCEPT_TLT","name_cn":"TLT（长期美债 ETF）","name_en":"iShares 20+ Year Treasury Bond ETF","definition":"持有 20 年期以上美债的 ETF，价格为长端收益率的反向代理（『利率方向确认器』）。","category":"市场指标","source_document_ids":["DOC_DXY"],"source_pages":[1,4],"verification_status":"author_claimed","notes":""},
  {"id":"CONCEPT_VIX","name_cn":"波动率指数（VIX）","name_en":"CBOE Volatility Index","definition":"标普500期权隐含波动率指数，度量市场恐慌与不确定性（『该不该下注』）。","category":"市场指标","source_document_ids":["DOC_DXY"],"source_pages":[1,5,9,10],"verification_status":"author_claimed","notes":""},
  {"id":"CONCEPT_TERM_PREMIUM","name_cn":"期限溢价","name_en":"Term Premium","definition":"长端收益率中补偿期限风险的成分；其变化造成收益率与 TLT 背离，常见于财政赤字/债务风险阶段。","category":"利率结构","source_document_ids":["DOC_DXY"],"source_pages":[4,5],"verification_status":"author_claimed","notes":""},
  {"id":"CONCEPT_YIELD_CURVE","name_cn":"收益率曲线","name_en":"Yield Curve","definition":"同信用等级国债收益率随期限的分布；T-Notes 构成中段，曲线形态用于观察政策预期、通胀与增长。","category":"利率结构","source_document_ids":["DOC_TSY"],"source_pages":[1,2],"verification_status":"author_claimed","notes":""},
  {"id":"CONCEPT_BREAKEVEN","name_cn":"平衡通胀率","name_en":"Breakeven Inflation Rate","definition":"同期限名义国债收益率与 TIPS 收益率之差，为市场定价的通胀预期指标（原文认为比调查更可靠）。","category":"利率结构","source_document_ids":["DOC_TSY"],"source_pages":[3],"verification_status":"author_claimed","notes":"严格而言还包含通胀风险溢价与流动性差异。"},
  {"id":"CONCEPT_RUSSELL2000","name_cn":"罗素2000指数","name_en":"Russell 2000","definition":"美国小盘股指数；原文定位为『流动性晴雨表』与内生风险资产，对流动性/信贷最敏感。","category":"市场指标","source_document_ids":["DOC_DXY","DOC_LIQ"],"source_pages":[6,9],"verification_status":"author_claimed","notes":""},
  {"id":"CONCEPT_BTC","name_cn":"比特币（大饼）","name_en":"Bitcoin","definition":"原文定位：全球流动性 β × 高杠杆风险资产；非数字黄金、非避险资产；流动性最敏感的『探针』。","category":"加密资产","source_document_ids":["DOC_LIQ","DOC_DXY","DOC_FED","DOC_TGA"],"source_pages":[1],"verification_status":"author_claimed","notes":""},
  {"id":"CONCEPT_STABLECOIN","name_cn":"稳定币发行量","name_en":"Stablecoin Supply","definition":"稳定币总供给/市值；被 Frank 用作流动性传导的同步观察指标（增发=流入加密市场的资金证据之一）。","category":"加密资产","source_document_ids":["DOC_LIQ"],"source_pages":[1],"verification_status":"source_claimed","notes":""},
  {"id":"CONCEPT_BTC_ETF","name_cn":"比特币现货 ETF 资金流","name_en":"BTC Spot ETF Flows","definition":"现货 ETF 净流入/流出；与稳定币供给一同作为流动性传导的同步观察指标。","category":"加密资产","source_document_ids":["DOC_LIQ"],"source_pages":[1],"verification_status":"source_claimed","notes":""},
