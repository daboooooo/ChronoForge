# ChronoForge 环境配置模板（docs/design/08-cli-config-security.md §1）
# 复制为 .env 后填写；加载顺序：defaults < .env < 环境变量

# 运行环境：default | development | test | production
CHRONOFORGE_ENV=default

# 数据目录（Raw/Canonical/Derived，运行时生成）
CHRONOFORGE_DATA_DIR=./data

# 元数据目录（SQLite chronoforge.db）
CHRONOFORGE_META_DIR=./meta

# 日志级别
CHRONOFORGE_LOG_LEVEL=INFO

# FRED API Key（启用 FRED 数据源时必填，缺失启动即 ConfigError）
FRED_API_KEY=

# SEC fair-access 联系邮箱（User-Agent 必填项）
CHRONOFORGE_SEC_CONTACT=

# HTTP 超时（秒）
CHRONOFORGE_HTTP_TIMEOUT=30

# 重试上限（指数退避 1/2/4/8/16s + jitter）
CHRONOFORGE_RETRY_MAX=5

# 质量阻断规则（逗号分隔 rule_id；默认 Q-SCHEMA-001,Q-PROV-001）
CHRONOFORGE_QUALITY_BLOCK=

# 限流覆盖（JSON，测试注入用）
CHRONOFORGE_RATE_OVERRIDES={}
