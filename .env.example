# ChronoForge Configuration（D08 §1 全部 env 名；复制为 .env 后填值）
# 加载顺序：defaults ← .env ← 环境变量（环境变量胜出）
# .env 已在 .gitignore，禁止提交真实凭证

# ── 运行时（Runtime）──
# 多环境：default | development | test | production（约束 §25）
CHRONOFORGE_ENV=default
# 数据目录（Raw/Canonical/Derived）
CHRONOFORGE_DATA_DIR=./data
# 元数据目录（SQLite + DuckDB 查询目录）
CHRONOFORGE_META_DIR=./meta
# 日志级别：DEBUG | INFO | WARNING | ERROR
CHRONOFORGE_LOG_LEVEL=INFO
# HTTP 超时（秒）
CHRONOFORGE_HTTP_TIMEOUT=30
# 重试上限（指数退避 + jitter）
CHRONOFORGE_RETRY_MAX=5
# 质量阻断规则（逗号分隔；D06 §3）
CHRONOFORGE_QUALITY_BLOCK=Q-SCHEMA-001,Q-PROV-001
# 标准化错误阈值（D05）
# CHRONOFORGE_NORMALIZE_ERROR_THRESHOLD=0.10
# 限流覆盖（JSON，测试注入；键为 rate limiter 名）
CHRONOFORGE_RATE_OVERRIDES={}

# ── 秘密（Secret；SecretStr 包装，永不落盘/入库/入日志）──
# FRED API key（启用 fred 源时必填；缺失 → ConfigError，D08 §1）
FRED_API_KEY=
# SEC fair-access 联系邮箱（SEC EDGAR User-Agent 必填项，D04 §4.7）
CHRONOFORGE_SEC_CONTACT=research@example.com
# CCXT Bridge 凭证（可选，随底层交易所）
CCXT_BINANCE_API_KEY=
CCXT_BINANCE_SECRET=
CCXT_OKX_API_KEY=
CCXT_OKX_SECRET=
CCXT_OKX_PASSPHRASE=
